{
  "contracts": {
    "android/demo/chassis": [
      {
        "reader": "the Android example, chassis-ui/android-example, which names the fonts by role, the logo and the app icon",
        "files": [
          "res/font/{ui,prose,display}_{elegant,normal,strong,mass}{,_italic}.ttf",
          "res/font/code_{normal,strong}.ttf",
          "res/drawable-nodpi/logo.png",
          "res/drawable-night-nodpi/logo.png",
          "res/drawable/ic_{arrow_left_solid,arrow_right_from_bracket_solid,bell_solid,check_solid,chevron_right_solid,cube_solid,envelope_outline,envelope_solid,eye_outline,eye_slash_outline,filter_solid,globe_solid,grid_solid,heart_outline,heart_solid,home_solid,info_solid,lock_solid,moon_solid,palette_solid,paper_plane_solid,search_solid,sparkles_solid,star_solid,swatchbook_solid,trash_solid,user_solid,xmark_solid}.xml",
          "res/drawable{,-xhdpi,-night,-night-xhdpi}/{figma_library,figma_tokens,figma_docs,comp_gallery}.png",
          "res/drawable{,-xhdpi}/{lego_chassis,platforms}.png",
          "res/mipmap-anydpi-v26/app_icon.xml"
        ]
      }
    ],
    "android/demo/sinefil": [
      {
        "reader": "the Android example, chassis-ui/android-example, which names the fonts by role, the logo and the app icon",
        "files": [
          "res/font/{ui,prose,display}_{elegant,normal,strong,mass}{,_italic}.ttf",
          "res/font/code_{normal,strong}.ttf",
          "res/drawable-nodpi/logo.png",
          "res/drawable-night-nodpi/logo.png",
          "res/drawable/ic_{arrow_left_solid,arrow_right_from_bracket_solid,bell_solid,check_solid,chevron_right_solid,cube_solid,envelope_outline,envelope_solid,eye_outline,eye_slash_outline,filter_solid,globe_solid,grid_solid,heart_outline,heart_solid,home_solid,info_solid,lock_solid,moon_solid,palette_solid,paper_plane_solid,search_solid,sparkles_solid,star_solid,swatchbook_solid,trash_solid,user_solid,xmark_solid}.xml",
          "res/drawable{,-xhdpi,-night,-night-xhdpi}/{figma_library,figma_tokens,figma_docs,comp_gallery}.png",
          "res/drawable{,-xhdpi}/{lego_chassis,platforms}.png",
          "res/mipmap-anydpi-v26/app_icon.xml"
        ]
      }
    ],
    "ios/demo/chassis": [
      {
        "reader": "the iOS example, chassis-ui/ios-example, which names the fonts by role and the app icon",
        "files": [
          "fonts/{ui,prose,display}_{elegant,normal,strong,mass}{,_italic}.ttf",
          "fonts/code_{normal,strong}.ttf",
          "app-icon/app_icon.icon/icon.json"
        ]
      }
    ],
    "ios/demo/sinefil": [
      {
        "reader": "the iOS example, chassis-ui/ios-example, which names the fonts by role and the app icon",
        "files": [
          "fonts/{ui,prose,display}_{elegant,normal,strong,mass}{,_italic}.ttf",
          "fonts/code_{normal,strong}.ttf",
          "app-icon/app_icon.icon/icon.json"
        ]
      }
    ],
    "web/docs/chassis": [
      {
        "reader": "Navigation.astro and Footer.astro of @chassis-ui/docs, which inline it from 0.10 on and fail the build of a site without it",
        "files": ["images/site-logo.svg"]
      },
      {
        "reader": "Head.astro of @chassis-ui/docs 0.10 and later",
        "files": ["fonts/fonts.css"]
      },
      {
        "reader": "Favicons.astro of @chassis-ui/docs, and the aliases of the website",
        "files": ["images/{favicon,favicon-16x16,favicon-32x32,apple-touch-icon}.png"]
      },
      {
        "reader": "the manifest.json of each site",
        "files": ["images/android-chrome-{192x192,512x512}.png"]
      },
      {
        "reader": "BaseLayout.astro of @chassis-ui/docs, which fails the build of a site without it",
        "files": ["images/social-image.png"]
      },
      {
        "reader": "the home page of every site, which fails the build of a site without it",
        "files": ["icons/cx-sprite.svg"]
      },
      {
        "reader": "GalleryImage.astro of the website and ResponsiveImage.astro of chassis-tokens",
        "files": ["images/home/comp-gallery-{light,dark}{,-small}{,@2x}.{png,webp}"]
      },
      {
        "reader": "FigmaSection.astro of the website",
        "files": ["images/home/figma-{docs,library,tokens}-{light,dark}{,@2x}.webp"]
      },
      {
        "reader": "IconsSection.astro and TokensSection.astro of the website",
        "files": [
          "images/home/icon-library-{light,dark}.svg",
          "images/home/tokens-{scheme,visual}.svg"
        ]
      },
      {
        "reader": "ExampleImage.astro and CxVariant.astro of chassis-figma",
        "sets": [
          "images/figma/components/*/{light,dark}/*.png",
          {
            "pattern": "images/figma/components/*/{light,dark}/*{,@2x}.png",
            "except": [
              "images/figma/components/*/*/card-orientation-top-*.png",
              "images/figma/components/*/*/list-item-text-basic-*.png"
            ]
          }
        ]
      }
    ],
    "web/docs/sinefil": [
      {
        "reader": "the root layout of sinefil.org, which links the stylesheet and inlines the logo",
        "files": ["fonts/fonts.css", "images/site-logo.svg"]
      },
      {
        "reader": "the favicons of sinefil.org",
        "files": [
          "images/favicon.{svg,ico}",
          "images/{favicon-16x16,favicon-32x32,apple-touch-icon}.png"
        ]
      },
      {
        "reader": "the web manifest of sinefil.org, which reads other/manifest.json and the icons it names",
        "files": [
          "other/manifest.json",
          "images/android-chrome-{192x192,512x512,512x512-maskable}.png"
        ]
      },
      {
        "reader": "the stand-in for a missing cover on sinefil.org, which inlines the logomark",
        "files": ["images/site-logomark.svg"]
      },
      {
        "reader": "the social card of sinefil.org",
        "files": ["images/social-image.png"]
      }
    ]
  },
  "lint": {
    "allow": [
      {
        "pattern": "*/*/icons/icons/chassis-icons.min.css",
        "reason": "part of the build output of @chassis-ui/icons, copied as it is; the web output is chassis-icons-min.css"
      }
    ]
  }
}
