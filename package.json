{
  "name": "@chassis-ui/website-assets",
  "version": "0.5.1",
  "private": true,
  "description": "The assets of the Chassis websites and apps: the chassis and sinefil brands, the docs and demo apps, built with @chassis-ui/assets",
  "chassis": {
    "defaults": {
      "brandFolder": "_default"
    },
    "build": {
      "brands": [
        "chassis",
        "sinefil"
      ],
      "apps": {
        "docs": [
          "web"
        ],
        "demo": [
          "ios",
          "android"
        ]
      }
    },
    "subset": {
      "ranges": [
        "latin",
        "latin-ext",
        "cyrillic",
        "greek",
        "symbols2",
        "U+2190-2193"
      ],
      "axes": {
        "chassis": {
          "opsz": 14
        }
      },
      "split": true
    }
  },
  "scripts": {
    "build": "chassis-assets build",
    "build:release": "chassis-assets build --optimize --subset --asset-catalog --icon-catalog --res --vector-drawables",
    "lint": "chassis-assets lint-source",
    "verify": "chassis-assets verify",
    "archive": "chassis-assets archive",
    "analyze": "chassis-assets analyze",
    "release-notes": "chassis-assets release-notes",
    "assets:site": "chassis-assets build --clean --brand chassis --app docs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/website-assets.git"
  },
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@chassis-ui/assets": "^0.12.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "svg2vectordrawable": "^2.9.1",
    "svgo": "^4.1.0"
  }
}
